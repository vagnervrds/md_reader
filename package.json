{
  "name": "mdreader",
  "version": "1.0.0",
  "description": "Leitor de Markdown leve com interface web",
  "main": "src/index.js",
  "scripts": {
    "start": "go run ./cmd/mdreader",
    "build:win": "cmd /c build.bat",
    "build:sh": "sh build.sh",
    "release": "python generate_release_notes.py --publish",
    "test": "go test ./..."
