    "marked-highlight": "^2.2.1",
    "opn": "^6.0.0",
    "sequelize": "^6.37.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "resedit": "^3.1.0"
  }
}
